---
import { Image } from 'astro:assets';
import newLogo from '../../assets/straight-positive-thinking-llc-01-3_nw_895cee9b.jpg';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const services = [
  {
    slug: 'wedding-ceremonies',
    title: 'Wedding Ceremonies',
    emoji: '💍',
    tagline: 'Faith-filled, personalized ceremonies officiated by an ordained minister.',
    desc: 'Steven Jerome Bennett Jr. is a licensed and ordained minister authorized to perform wedding ceremonies. Bring genuine faith, positive energy, and heartfelt joy to your special day with a ceremony that reflects your unique love story and spiritual journey.',
    features: ['Personalized ceremony script', 'Pre-ceremony consultation', 'Faith-based or interfaith options', 'Ordained & licensed minister', 'Available for venues across the region'],
  },
  {
    slug: 'motivational-speaking',
    title: 'Motivational Speaking',
    emoji: '🎤',
    tagline: 'Spirit-led talks for churches, schools, businesses, and communities.',
    desc: 'STR8 Positive Thinking brings authentic, faith-rooted encouragement to any stage. Whether it\'s a church service, school assembly, corporate event, or community gathering — Stevie Da Troublemaker delivers real talk, real faith, real impact.',
    features: ['Keynote & guest speaking', 'Church & ministry events', 'Schools & universities', 'Corporate & business events', 'Community & youth events', 'Christian rap & spoken word performance'],
  },
  {
    slug: 'encouragement-support',
    title: 'Encouragement & Support',
    emoji: '🙏',
    tagline: 'Non-clinical, faith-rooted support for healthcare staff, patients & families.',
    desc: 'We meet people where they are — emotionally and spiritually. STR8 Positive Thinking provides non-clinical encouragement visits and support sessions for hospitals, healthcare workers, patients, families, and anyone navigating difficult seasons of life.',
    features: ['Hospital & healthcare staff morale sessions', 'Patient & family encouragement visits', 'Chaplain & spiritual care partnerships', 'Prayer & intercession', 'One-on-one encouragement conversations', 'Burnout recovery support for professionals'],
  },
  {
    slug: 'youth-programs',
    title: 'Youth Programs',
    emoji: '⭐',
    tagline: 'High-energy, purpose-driven programming for young people.',
    desc: 'Built specifically for the next generation — STR8 Positive Thinking\'s youth programs are high-energy, age-appropriate, and rooted in identity, purpose, and faith. Interactive Q&A, spoken word, and real conversation help students feel seen, heard, and inspired.',
    features: ['School & university events', 'After-school & youth group programs', 'Identity & purpose talks', 'Interactive Q&A sessions', 'Spoken word & creative expression', 'Campus ministry partnerships'],
  },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Our Services - STR8 Positive Thinking</title>
  <meta name="description" content="STR8 Positive Thinking offers wedding ceremonies, motivational speaking, encouragement & support, and youth programs — all Spirit-led." />
  <link rel="canonical" href={canonicalURL} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --neon: #5debdd; --neon-dark: #3db8ac;
      --neon-glow: 0 0 18px rgba(93,235,221,0.4);
      --dark-bg: #0a0a0a; --dark-surface: #111; --dark-surface-2: #191919;
      --text-primary: #fff; --text-secondary: rgba(255,255,255,0.7);
      --border-color: rgba(93,235,221,0.18);
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Poppins',sans-serif; background:var(--dark-bg); color:var(--text-primary); line-height:1.6; overflow-x:hidden; }
    h1,h2,h3,h4 { font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.25; }
    .container { width:100%; max-width:1200px; margin:0 auto; padding:0 1.5rem; }
    .neon-text { background:linear-gradient(135deg,#5debdd,#3db8ac); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }

    header { position:fixed; top:0; left:0; width:100%; z-index:1000; background:rgba(10,10,10,0.95); backdrop-filter:blur(12px); border-bottom:1px solid var(--border-color); padding:0.9rem 0; }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo-wrap { display:flex; align-items:center; text-decoration:none; }
    nav a { color:var(--text-secondary); text-decoration:none; font-weight:500; font-size:0.9rem; margin-left:1.75rem; transition:color 0.3s; }
    nav a:hover, nav a.active { color:var(--neon); }

    .divider { width:70px; height:3px; background:linear-gradient(90deg,#5debdd,#3db8ac); margin:0.6rem auto 0.8rem; border-radius:2px; box-shadow:var(--neon-glow); }

    .page-hero { min-height:32vh; display:flex; align-items:center; justify-content:center; padding:6rem 0 2.5rem; text-align:center; background:radial-gradient(circle at 50% 60%, rgba(93,235,221,0.07) 0%, transparent 65%); }
    .page-hero h1 { font-size:clamp(2rem,6vw,3.5rem); margin-bottom:0.75rem; }

    .services-list { padding:3rem 0; }
    .service-row { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:center; padding:2.5rem 0; border-bottom:1px solid var(--border-color); }
    .service-row:last-child { border-bottom:none; }
    .service-row.reverse { direction:rtl; }
    .service-row.reverse > * { direction:ltr; }

    .service-visual { background:var(--dark-surface-2); border:1px solid var(--border-color); border-radius:20px; padding:3rem 2rem; text-align:center; }
    .service-emoji { font-size:4.5rem; display:block; margin-bottom:1rem; }
    .service-visual h3 { font-size:1.5rem; color:#5debdd; }

    .service-info h2 { font-size:clamp(1.6rem,4vw,2.2rem); margin-bottom:0.5rem; }
    .service-tagline { font-size:1rem; color:#5debdd; font-weight:600; margin-bottom:1rem; }
    .service-desc { font-size:0.95rem; color:var(--text-secondary); line-height:1.75; margin-bottom:1.25rem; }
    .feature-list { list-style:none; padding:0; margin-bottom:1.5rem; }
    .feature-list li { padding:0.35rem 0 0.35rem 1.5rem; position:relative; font-size:0.9rem; color:var(--text-secondary); }
    .feature-list li::before { content:'✓'; position:absolute; left:0; color:#5debdd; font-weight:700; }

    .btn-neon { display:inline-flex; align-items:center; gap:0.6rem; background:linear-gradient(135deg,#5debdd,#3db8ac); color:#0a0a0a; font-weight:700; padding:0.75rem 1.75rem; border-radius:50px; text-decoration:none; font-size:0.95rem; box-shadow:var(--neon-glow); transition:all 0.3s ease; }
    .btn-neon:hover { transform:translateY(-2px); box-shadow:0 0 28px rgba(93,235,221,0.5); }
    .btn-outline { display:inline-flex; align-items:center; gap:0.6rem; border:2px solid #5debdd; color:#5debdd; background:transparent; padding:0.7rem 1.6rem; border-radius:50px; text-decoration:none; font-weight:600; font-size:0.95rem; transition:all 0.3s ease; margin-left:0.75rem; }
    .btn-outline:hover { background:rgba(93,235,221,0.1); }

    /* Quick grid at top */
    .quick-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:3rem; }
    .quick-card { background:var(--dark-surface); border:1px solid var(--border-color); border-radius:14px; padding:1.25rem 1rem; text-align:center; text-decoration:none; color:var(--text-primary); transition:all 0.3s ease; }
    .quick-card:hover { border-color:rgba(93,235,221,0.5); transform:translateY(-3px); box-shadow:var(--neon-glow); }
    .quick-card .q-emoji { font-size:2rem; display:block; margin-bottom:0.5rem; }
    .quick-card h4 { font-size:0.9rem; color:#5debdd; }

    footer { background:var(--dark-surface); border-top:1px solid var(--border-color); padding:2rem 0; text-align:center; }
    footer p { color:var(--text-secondary); font-size:0.9rem; }

    @media (max-width:900px) {
      .quick-grid { grid-template-columns:repeat(2,1fr); }
      .service-row, .service-row.reverse { grid-template-columns:1fr; direction:ltr; gap:1.5rem; }
    }
    @media (max-width:600px) {
      .quick-grid { grid-template-columns:repeat(2,1fr); gap:0.6rem; }
      nav { display:none; }
      .services-list { padding:2rem 0; }
      .service-row { padding:1.5rem 0; }
    }
  </style>
</head>
<body>
  <header>
    <div class="container header-inner">
      <a href="/" class="logo-wrap">
        <Image src={newLogo} alt="STR8 Positive Thinking" width="52" height="52" style="border-radius:50%;border:2px solid #5debdd;box-shadow:0 0 12px rgba(93,235,221,0.35);" />
      </a>
      <nav>
        <a href="/">Home</a>
        <a href="/services" class="active">Services</a>
        <a href="/info">Info</a>
        <a href="/team">Team</a>
        <a href="/booking">Book</a>
        <a href="/donate">Donate</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="page-hero">
    <div>
      <h1><span class="neon-text">Our Services</span></h1>
      <div class="divider"></div>
      <p style="color:var(--text-secondary);font-size:1rem;max-width:550px;margin:0 auto;">Spirit-led encouragement, speaking, and outreach for every setting — hospitals, schools, churches, and communities.</p>
    </div>
  </div>

  <section class="services-list">
    <div class="container">
      <!-- Quick jump grid -->
      <div class="quick-grid">
        {services.map(s => (
          <a href={`/services/${s.slug}`} class="quick-card">
            <span class="q-emoji">{s.emoji}</span>
            <h4>{s.title}</h4>
          </a>
        ))}
      </div>

      <!-- Full service rows -->
      {services.map((s, i) => (
        <div class={`service-row${i % 2 === 1 ? ' reverse' : ''}`}>
          <div class="service-visual">
            <span class="service-emoji">{s.emoji}</span>
            <h3>{s.title}</h3>
          </div>
          <div class="service-info">
            <h2>{s.title}</h2>
            <p class="service-tagline">{s.tagline}</p>
            <p class="service-desc">{s.desc}</p>
            <ul class="feature-list">
              {s.features.map(f => <li>{f}</li>)}
            </ul>
            <a href={`/services/${s.slug}`} class="btn-neon">Learn More →</a>
            <a href="/booking" class="btn-outline">Book Now</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="background:var(--dark-surface);padding:2.5rem 0;text-align:center;">
    <div class="container" style="max-width:650px;">
      <h2 style="font-size:clamp(1.6rem,4vw,2.2rem);margin-bottom:0.75rem;">Ready to <span class="neon-text">Book STR8 Positive?</span></h2>
      <div class="divider"></div>
      <p style="color:var(--text-secondary);margin-bottom:1.75rem;font-size:0.95rem;">Reach out today to discuss your event, need, or community. Let's make something real happen. #GoJesus 🙏</p>
      <a href="/booking" class="btn-neon" style="font-size:1rem;padding:0.9rem 2rem;">Submit a Booking Request</a>
    </div>
  </section>

  <footer>
    <div class="container">
      <p><span class="neon-text" style="font-weight:700;">STR8 POSITIVE THINKING</span> — Spirit-Led Encouragement with Purpose</p>
      <p style="margin-top:0.5rem;">&copy; {new Date().getFullYear()} All rights reserved. | <a href="/" style="color:#5debdd;text-decoration:none;">Home</a></p>
    </div>
  </footer>
</body>
</html>
